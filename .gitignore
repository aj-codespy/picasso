# Picasso — a searchable design-inspiration library
# (generated data; screenshots are never committed)

# user screenshots — never commit these
src/picasso/screenshots/*.png
src/picasso/screenshots/*.jpg
src/picasso/screenshots/*.jpeg
src/picasso/screenshots/*.webp

# user-owned favorites + notes overlay (best-effort persistence)
src/picasso/meta.json

# local backup of a generated library
src/picasso/data/library.backup.json

# generated dist bundle (contains mirrors of your screenshots — rebuild locally)
dist/

# corrupt-file recovery backups (see designlib._recover_corrupt)
src/picasso/data/*.corrupt-*

# private planning docs (superseded by README)
PRODUCT.md
IDEA.md

# legacy scripts — superseded by designlib.py (hardcode a personal env path)
src/picasso/add_design.py
src/picasso/batch_analyze.py
src/picasso/analyze.py
src/picasso/nim_peek.py

.env
__pycache__/
*.pyc
.DS_Store
.hermes/
.venv/
*.log
